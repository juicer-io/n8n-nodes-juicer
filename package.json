{
	"name": "n8n-nodes-juicer",
	"version": "0.1.0",
	"description": "n8n nodes for the Juicer API: social listening, social data lookups and social feeds",
	"license": "MIT",
	"homepage": "https://developers.juicer.io",
	"keywords": [
		"n8n-community-node-package",
		"juicer",
		"social listening",
		"social media",
		"social data"
	],
	"author": {
		"name": "Juicer",
		"email": "hello@juicer.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/juicer-io/n8n-nodes-juicer.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/JuicerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Juicer/Juicer.node.js",
			"dist/nodes/JuicerTrigger/JuicerTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
