    {
      "parameters": {
        "jsCode": "// A new source's first sync can deliver 100+ posts in one go.\n// Triage only the newest few so the AI and chat costs stay small.\nconst maxPosts = Number($('Your settings').first().json.max_posts_per_delivery) || 5;\nconst postedAt = item => new Date(item.json.external_created_at || item.json.created_at || 0).getTime();\n\nreturn $input.all().sort((a, b) => postedAt(b) - postedAt(a)).slice(0, maxPosts);"
      },
      "id": "3088b232-658c-598c-9d58-c1853b61c860",
      "name": "Keep the newest posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        200
      ]
    },
    {
      "parameters": {
        "text": "=Classify this social media post about our brand.\n\nPlatform: {{ $json.platform }}\nAuthor: {{ $json.poster?.name || 'unknown' }}\nPost: {{ ($json.message || '').slice(0, 1500) }}",
        "schemaType": "fromAttributes",
        "attributes": {
          "attributes": [
            {
              "name": "type",
              "type": "string",
              "description": "One word: complaint (unhappy customer or problem), question (asks something), praise (positive about the brand), spam (ads, scams, unrelated promotion) or other.",
              "required": true
            },
            {
              "name": "urgency",
              "type": "string",
              "description": "One word: high (angry, public risk or many people affected), normal or low.",
              "required": true
            },
            {
              "name": "summary",
              "type": "string",
              "description": "One short sentence saying what the post is about.",
              "required": true
            },
            {
              "name": "suggested_reply",
              "type": "string",
              "description": "A short, friendly reply a support person could post, in the language of the post. Write \"none\" for spam.",
              "required": true
            }
          ]
        },
        "options": {}
      },
