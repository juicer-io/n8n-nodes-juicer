      "id": "fc8534ee-0931-507f-879d-ba09703ed19f",
      "name": "Read the history",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1380,
        100
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Ranks every account by follower growth since its previous row in the sheet.\nconst thisWeek = $now.toFormat('yyyy-MM-dd');\nconst asDay = value => typeof value === 'number'\n  ? new Date(Math.round((value - 25569) * 86400000)).toISOString().slice(0, 10)\n  : String(value).slice(0, 10);\nconst byAccount = {};\nfor (const { json: row } of $input.all()) {\n  const key = row.platform + '|' + String(row.handle).toLowerCase();\n  (byAccount[key] ??= []).push({ ...row, week: asDay(row.week), followers: Number(String(row.followers).replace(/[^0-9.]/g, '')) });\n}\n\nconst changes = [];\nfor (const rows of Object.values(byAccount)) {\n  const current = rows.filter(row => row.week === thisWeek).at(-1);\n  const previous = rows.filter(row => row.week < thisWeek).sort((a, b) => a.week.localeCompare(b.week)).at(-1);\n  if (!current || !previous || !previous.followers) continue;\n  const change = current.followers - previous.followers;\n  changes.push({ name: current.competitor + ' on ' + current.platform, change, growth: (change / previous.followers) * 100, since: previous.week });\n}\n\nchanges.sort((a, b) => b.growth - a.growth);\nconst sign = n => (n >= 0 ? '+' : '');\nconst text = changes.length\n  ? '*Competitor growth this week* (vs ' + changes[0].since + ')\\n' + changes.map((c, i) =>\n      (i + 1) + '. ' + c.name + ': ' + sign(c.change) + c.change.toLocaleString('en-US') + ' followers (' +\n      sign(c.growth) + c.growth.toFixed(2) + '%)').join('\\n')\n  : 'First week logged. From next week this message ranks who grew fastest.';\nreturn [{ json: { text } }];"
      },
      "id": "7bd0e596-7831-5699-9df0-15d06caff288",
      "name": "Compare with last week",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        100
      ]
