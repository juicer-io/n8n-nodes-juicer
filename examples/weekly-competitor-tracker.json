      "parameters": {
        "jsCode": "// One row per competitor and platform. Brands often use different handles per\n// platform, so list each one. Check the account's own bio before adding it.\nconst accounts = [\n  { competitor: 'Competitor A', platform: 'Instagram', handle: 'competitor_a' },\n  { competitor: 'Competitor A', platform: 'Twitter', handle: 'competitora' },\n  { competitor: 'Competitor B', platform: 'YouTube', handle: 'competitorb' },\n  // Platforms: Instagram, TikTok, Twitter (X), YouTube, LinkedIn, Facebook, Pinterest, Bluesky\n];\nreturn accounts.map(account => ({ json: account }));"
      }
